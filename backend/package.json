{
  "name": "code2flow-backend",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "eval": "tsx src/eval/run-baseline.ts",
    "eval:ab": "tsx src/eval/compare-reports.ts",
    "eval:traces": "tsx src/eval/analyze-traces.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0",
    "@langchain/core": "1.2.18",
    "@langchain/langgraph": "1.5.1",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "@langchain/openai": "1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "langchain": "1.5.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.19.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
