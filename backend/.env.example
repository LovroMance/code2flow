# 统一使用原生 StateGraph；旧 CODE2FLOW_AGENT_PROVIDER 无需再配置
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0
# Jev Choice 语言识别；替换占位密钥后启用真实调用
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_DEFAULT_MODEL=jev-1.14.0
CODE2FLOW_LANGUAGE_TIMEOUT_MS=5000
CODE2FLOW_LANGUAGE_MIN_CONFIDENCE=0.6
CODE2FLOW_CHECKPOINT_DB=.code2flow/checkpoints/code-flow.sqlite
# 仅用于按需导入旧 JSON 会话，可不配置；原文件保持只读
CODE2FLOW_CHECKPOINT_FILE=.code2flow/checkpoints/code-flow-checkpoints.json
CODE2FLOW_MAX_RETRIES=1
PORT=3000

# v2 多文件分析：实际模型上下文窗口必须按供应商配置填写
CODE2FLOW_MULTI_MAX_FILES=20
CODE2FLOW_MULTI_MAX_TOTAL_BYTES=2097152
CODE2FLOW_MULTI_CONCURRENCY=3
CODE2FLOW_MULTI_MAX_MODEL_CALLS=120
CODE2FLOW_MULTI_MAX_INPUT_TOKENS=600000
CODE2FLOW_MULTI_MAX_OUTPUT_TOKENS=80000
CODE2FLOW_MULTI_TIMEOUT_MS=900000
# 每次模型调用的输出上限，同时用于请求参数和预算预留；按实际供应商能力设置
CODE2FLOW_MODEL_MAX_OUTPUT_TOKENS=4000
# 只限制单个索引任务大小，不限制上传文件总行数
CODE2FLOW_MULTI_CHUNK_LINES=60
CODE2FLOW_MULTI_CHUNK_CHARS=2000
CODE2FLOW_MODEL_CONTEXT_TOKENS=
# 独立 Embedding 服务；留空时明确降级为关键词检索
CODE2FLOW_EMBEDDING_BASE_URL=
CODE2FLOW_EMBEDDING_API_KEY=
CODE2FLOW_EMBEDDING_MODEL=

# LangSmith 远程追踪；填好密钥后改为 true 并重启后端
# 启用后会上传 Graph 状态、模型消息（含用户源码）、工具参数和响应；只使用可上传的数据
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code2flow-dev
# 留空默认美国区域；其他区域填写 LangSmith 账号对应的 API 地址
LANGSMITH_ENDPOINT=
# 仅当 API Key 关联多个 workspace 或账号要求时填写
LANGSMITH_WORKSPACE_ID=
LANGCHAIN_CALLBACKS_BACKGROUND=true
